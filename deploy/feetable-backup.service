[Unit]
Description=FeeTable daily SQLite backup

[Service]
Type=oneshot
User=feetable
Group=feetable
EnvironmentFile=/opt/feetable/config/feetable.env
ExecStart=/usr/bin/flock --shared /run/lock/ali-release-retention.lock /opt/feetable/bin/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/feetable/data /opt/feetable/backups
