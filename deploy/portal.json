{
  "id": "feetable",
  "name": "FeeTable",
  "description": "运输记录、运费统计与报表。",
  "icon": "/portal/static/icons/feetable.png",
  "url": "/feetable/",
  "repo": "https://github.com/Crashmere/FeeTable",
  "root": "/opt/feetable",
  "port": 18081,
  "user": "feetable",
  "units": [
    "feetable.service",
    "feetable-backup.service",
    "feetable-backup.timer"
  ],
  "database": "/opt/feetable/data/feetable.sqlite",
  "backupKind": "sqlite",
  "resources": [
    {
      "id": "data",
      "name": "业务数据",
      "path": "/opt/feetable/data",
      "purpose": "数据库、图片与历史迁移材料；临时文件不属于恢复数据。",
      "kind": "data",
      "browse": true,
      "cleanup": false
    },
    {
      "id": "backups",
      "name": "数据备份",
      "path": "/opt/feetable/backups",
      "purpose": "每日快照保留 14 份；发布前快照保留最近 5 份及受保护版本对应快照；手工备份不自动清理。",
      "kind": "backups",
      "browse": true,
      "cleanup": true
    },
    {
      "id": "releases",
      "name": "部署版本",
      "path": "/opt/feetable/releases",
      "purpose": "保留最近 3 次成功发布和当前运行版本；已确认恢复的失败批次在后续成功发布且超过 7 天后清理。",
      "kind": "releases",
      "browse": true,
      "cleanup": true
    },
    {
      "id": "config",
      "name": "运行配置",
      "path": "/opt/feetable/config",
      "purpose": "环境配置、systemd、Nginx 与资源声明；不直接展示秘密。",
      "kind": "config",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "bin",
      "name": "服务程序",
      "path": "/opt/feetable/bin",
      "purpose": "当前应用程序及固定维护/发布脚本。",
      "kind": "binaries",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "docs",
      "name": "维护文档",
      "path": "/opt/feetable/docs",
      "purpose": "架构、API、运维与恢复说明。",
      "kind": "documents",
      "browse": true,
      "cleanup": false
    }
  ],
  "apis": [
    {
      "method": "GET",
      "path": "/healthz",
      "description": "数据库连接检查"
    },
    {
      "method": "GET",
      "path": "/api/tables",
      "description": "月表列表、条数、金额，30 条/页；查询参数 page（默认 1）、sort（默认 updated_desc），可附 year/month 筛选"
    },
    {
      "method": "POST",
      "path": "/api/tables",
      "description": "创建，year/month 必填"
    },
    {
      "method": "GET",
      "path": "/api/tables/{id}",
      "description": "表格、明细、全部标签、筛选条数/合计，50 条/页；查询参数 page（默认 1）、tag（可选）"
    },
    {
      "method": "PUT",
      "path": "/api/tables/{id}",
      "description": "修改 year/month，revision 必须匹配"
    },
    {
      "method": "DELETE",
      "path": "/api/tables/{id}",
      "description": "删除表格与明细，查询参数 revision 必须匹配当前表格版本"
    },
    {
      "method": "POST",
      "path": "/api/tables/{id}/merge",
      "description": "将同年月的来源表合并到 id 保留表"
    },
    {
      "method": "POST",
      "path": "/api/tables/{id}/records",
      "description": "新增明细，body 包含当前表格 revision"
    },
    {
      "method": "PUT",
      "path": "/api/tables/{id}/records/{record}",
      "description": "完整更新明细，body 包含当前表格 revision"
    },
    {
      "method": "DELETE",
      "path": "/api/tables/{id}/records/{record}",
      "description": "删除明细，查询参数 revision 必须匹配当前表格版本"
    },
    {
      "method": "GET",
      "path": "/api/locations",
      "description": "常用地点，按累计使用次数排序"
    },
    {
      "method": "GET",
      "path": "/api/tags",
      "description": "常用标签，按累计使用次数排序"
    },
    {
      "method": "POST",
      "path": "/api/locations",
      "description": "添加常用地点，body 为 {name}，已存在时不重复创建"
    },
    {
      "method": "POST",
      "path": "/api/tags",
      "description": "添加常用标签，body 为 {name}，已存在时不重复创建"
    },
    {
      "method": "PUT",
      "path": "/api/locations/{id}",
      "description": "地点改名，body 为 name、previousName"
    },
    {
      "method": "DELETE",
      "path": "/api/locations/{id}",
      "description": "删除常用地点，查询参数 name 为原名称，用于检查并发修改"
    },
    {
      "method": "GET",
      "path": "/api/tables/{id}/report",
      "description": "完整导出数据与 revision；可选查询参数 tag，不分页"
    },
    {
      "method": "GET",
      "path": "/api/tables/{id}/export",
      "description": "下载；查询参数 format 为 png/pdf/xlsx，可选 revision、tag，inline=1 可内联打开"
    }
  ]
}
